# Copy to .env and replace the placeholders before running the backend.
# Use a dedicated local database. URL-encode special characters in its password.
DATABASE_URL=postgresql+psycopg2://postgres:replace-with-local-password@localhost:5432/second_brain

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-generated-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Required for live chat and analysis. No real provider calls are made by tests.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_PROVIDER=gemini

# Keep disabled for normal use.
ENABLE_DEV_ENDPOINTS=false
